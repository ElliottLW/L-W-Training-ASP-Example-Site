@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold text-primary">Welcome to L-W Tech Training</h1>
    <p class="lead mt-3">Your go-to resource for hands-on Azure and ASP.NET Core training labs.</p>
    <hr class="my-4" />
    <p>This example site is part of the L-W Tech Training curriculum, demonstrating how to build and deploy ASP.NET Core web applications to <strong>Azure Web Apps</strong>.</p>
    <a class="btn btn-primary btn-lg mt-3" href="https://learn.microsoft.com/aspnet/core" target="_blank" rel="noopener noreferrer" role="button">Learn ASP.NET Core</a>
    <a class="btn btn-outline-secondary btn-lg mt-3 ms-2" href="https://learn.microsoft.com/azure/app-service" target="_blank" rel="noopener noreferrer" role="button">Azure App Service Docs</a>
</div>

<div class="row mt-5 g-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">🚀 Azure Deployment</h5>
                <p class="card-text">Learn how to deploy this ASP.NET Core application to Azure Web Apps as part of your cloud training labs.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">📚 ASP.NET Core MVC</h5>
                <p class="card-text">This site showcases the Model-View-Controller pattern using the latest ASP.NET Core framework features.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">🎓 L-W Tech Training</h5>
                <p class="card-text">Practical, project-based training that prepares you for real-world development and cloud deployments.</p>
            </div>
        </div>
    </div>
</div>
